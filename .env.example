# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real keys.

# ── Deployment profile ─────────────────────────────────────────────────────
# Controls which models are loaded and served.
#
# Deployment mode (default — CLIP + Qwen only, lower VRAM):
ACTIVE_MODELS=clip,qwen
#
# Research mode (all four local models):
# ACTIVE_MODELS=clip,blip2,llava,qwen

# ── Qwen quantization ──────────────────────────────────────────────────────
# When true, loads Qwen in 4-bit NF4 via bitsandbytes (~2 GB VRAM vs ~4 GB).
# Silently disabled if bitsandbytes is not installed or no CUDA is available.
QUANTIZE_QWEN=true

# ── GPT-4V (OpenAI Vision API) ─────────────────────────────────────────────
# Required for POST /predict/gpt4v  — returns HTTP 503 if not set.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_key_here

# Optional: override the GPT-4V model ID (default: gpt-4o)
# Valid options: gpt-4o, gpt-4o-mini, gpt-4-vision-preview
GPT4V_MODEL=gpt-4o

# ── Server ─────────────────────────────────────────────────────────────────
# Optional: set log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
