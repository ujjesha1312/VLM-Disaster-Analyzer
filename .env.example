# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real keys.

# ── GPT-4V (OpenAI Vision API) ─────────────────────────────────────────────
# Required for POST /predict/gpt4v  — returns HTTP 503 if not set.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_key_here

# Optional: override the GPT-4V model ID (default: gpt-4o)
# Valid options: gpt-4o, gpt-4o-mini, gpt-4-vision-preview
GPT4V_MODEL=gpt-4o

# ── Server ─────────────────────────────────────────────────────────────────
# Optional: set log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
