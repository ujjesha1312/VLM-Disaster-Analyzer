# ── Backend API base URL ────────────────────────────────────────────────────
#
# Local development (default):
#   VITE_API_URL=http://localhost:8000
#
# Hugging Face Spaces backend (set this in your Vercel dashboard):
#   VITE_API_URL=https://<your-space>.hf.space
#
# IMPORTANT: VITE_ prefix is required — Vite replaces this at build time.
# Never use plain API_URL without the VITE_ prefix; it will be undefined
# in the browser bundle.
#
# On Vercel: set VITE_API_URL in Project Settings → Environment Variables.
# The dashboard value overrides this file and takes effect on next deploy.
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
